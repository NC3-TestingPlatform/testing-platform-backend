# Every value here is the built-in default, so the stack starts on a fresh clone without this file.
# Copy to .env to change one: cp .env.example .env
# Compose reads .env from the project directory on its own; `make dev` passes it to the host-run API.
# A variant kept under another name (.env.local) needs the flag: docker compose --env-file .env.local up
#
# Development only.
# Production deployments supply real values through their own environment.
#
# The application-side variables below are parsed and validated by
# src/nc3_testing_platform/core/settings.py; any of them can also be supplied
# as NAME_FILE=/path to read the value from a mounted file (secrets convention).

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nc3_testing_platform
POSTGRES_PORT=5432
# Runtime application role (docs/database-roles.md). The role is created by a
# migration without a credential; apply this password once per PostgreSQL
# cluster (ALTER ROLE changes cluster-level state):
#   docker compose exec postgres psql -U postgres -d nc3_testing_platform \
#     -c "ALTER ROLE nc3_app PASSWORD 'nc3_app'"
# The value is interpolated raw into APP_DATABASE_URL, so keep it free of
# URL-reserved characters (@ : / % ? #) — or set APP_DATABASE_URL yourself
# with the password percent-encoded.
NC3_APP_DB_PASSWORD=nc3_app
# Platform-duty role (docs/database-roles.md): worker-platform and beat
# connect as app_platform. Same bootstrap as nc3_app, once per cluster:
#   docker compose exec postgres psql -U postgres -d nc3_testing_platform \
#     -c "ALTER ROLE app_platform PASSWORD 'app_platform'"
# Same raw-interpolation caveat; override PLATFORM_DATABASE_URL instead if the
# password needs percent-encoding.
NC3_PLATFORM_DB_PASSWORD=app_platform
# Credential-surface role (docs/database-roles.md): only the api service
# connects as nc3_auth. Same bootstrap as the two roles above, once per
# cluster:
#   docker compose exec postgres psql -U postgres -d nc3_testing_platform \
#     -c "ALTER ROLE nc3_auth PASSWORD 'nc3_auth'"
# Same raw-interpolation caveat; override AUTH_DATABASE_URL instead if the
# password needs percent-encoding.
NC3_AUTH_DB_PASSWORD=nc3_auth

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
# Erlang cookie, seeded into the data volume on first start (>= 20 characters).
RABBITMQ_COOKIE=DevOnlyRabbitCookie0123456789
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Celery
# Pools per IDR-004 / the egress-queues ADR: gevent on the scan queues,
# prefork on file-analysis and platform (children recycle after this many tasks).
CELERY_GEVENT_CONCURRENCY=100
CELERY_PREFORK_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=100

# Scan execution
# A task that overruns its timeout fails; a job that overruns terminates what is left.
SCAN_TASK_TIMEOUT_SECONDS=120
SCAN_JOB_TIMEOUT_SECONDS=900
# A running task heartbeats at the interval; the sweep marks it lost after the stale threshold.
SCAN_HEARTBEAT_INTERVAL_SECONDS=5
SCAN_STALE_AFTER_SECONDS=30
SCAN_SWEEP_INTERVAL_SECONDS=15

# Authentication (B3 / US #79)
# Deployment master key at the root of the envelope hierarchy: 64 hex chars
# (256 bits). DEVELOPMENT VALUE ONLY — a real deployment mounts a secret and
# sets APP_ENCRYPTION_MASTER_KEY_FILE=/run/secrets/app_encryption_master_key
# on the api service alone (workers never unwrap keys). Generate a real one:
#   openssl rand -hex 32
APP_ENCRYPTION_MASTER_KEY=00000000000000000000000000000000000000000000000000000000deadbeef
# Browser origin allowed to make cookie-bearing state changes (CSRF origin
# check). Leave unset in development; set to the public origin in production:
#AUTH_PUBLIC_ORIGIN=https://testing.nc3.lu

# MFA (B4 / US #80). Defaults are production-sane; shown here for discovery.
# Issuer label in authenticator apps; assurance currency for gated operations;
# the escalating verify lockout (threshold, base doubling per lockout, cap);
# and the per-IP window on POST /auth/mfa/verify.
#AUTH_TOTP_ISSUER=NC3 Testing Platform
#AUTH_MFA_ASSURANCE_MAX_AGE_SECONDS=900
#AUTH_MFA_FAILED_THRESHOLD=5
#AUTH_MFA_LOCKOUT_BASE_SECONDS=900
#AUTH_MFA_LOCKOUT_CAP_SECONDS=86400
#AUTH_MFA_VERIFY_RATE_LIMIT=5
#AUTH_MFA_VERIFY_RATE_WINDOW_SECONDS=60

# Domain verification (B6a / US #82). The token lifetime and the record prefix
# are the user-visible half: the challenge TXT record is published at
# _<prefix>-verify.<domain> and the token lapses after the TTL if it never
# appears. The rate limit bounds starting a challenge and replacing its token,
# per (organization, asset): 10 writes per 300s by default.
#VERIFICATION_TOKEN_TTL_DAYS=7
#VERIFICATION_RECORD_PREFIX=nc3
#VERIFICATION_CHALLENGE_RATE_LIMIT=10
#VERIFICATION_CHALLENGE_RATE_WINDOW_SECONDS=300

# DNS resolution for the verification check (B6b / US #263, IDR-019). There is no
# built-in default: an inherited one would ship every customer domain a
# self-hoster verifies to a resolver operator in another jurisdiction without
# them choosing to. An empty list means verification is not configured and the
# check answers 503 — the refusal is at use time, not startup, so an
# unconfigured deployment loses one operation rather than the whole API.
#
# Each entry declares its own transport, because the two operators NC3 uses
# speak different ones: Restena is DoT-only on 853 (plaintext 53 filtered),
# CIRCL is DoH-only on 443 (853 refused). tls_hostname is what the certificate
# is verified against; a DoT entry without it is refused at startup. There is no
# fallback to plaintext 53 on a TLS failure, ever.
#
# NC3 production: two operators, two endpoints each, QUORUM 3. A quorum only
# resists a compromised or coerced operator when it exceeds any single operator's
# endpoint count — with 2+2 and quorum 3, no one operator can forge a proof alone,
# and one stale cache still leaves three good answers.
#   Restena (LU): dnspub is public and verified reachable and validating.
#   DNS4EU (EU, EC-funded, consortium of national CERTs): verified DoT + DNSSEC.
# Use DNS4EU's UNFILTERED profile only. The `protective` profile (86.54.11.1/.201)
# blocks domains its threat feed flags, which would make verification fail with an
# unexplained "record not found" for exactly the customer most likely to be
# testing their posture. Same reason Quad9 and any adblock variant are unusable.
#VERIFICATION_RESOLVERS=[{"address":"158.64.1.29","transport":"dot","port":853,"tls_hostname":"dnspub.restena.lu"},{"address":"158.64.1.25","transport":"dot","port":853,"tls_hostname":"dns1.restena.lu"},{"address":"86.54.11.100","transport":"dot","port":853,"tls_hostname":"unfiltered.joindns4.eu"},{"address":"86.54.11.200","transport":"dot","port":853,"tls_hostname":"unfiltered.joindns4.eu"}]
#VERIFICATION_RESOLVER_QUORUM=3
# dns1.restena.lu is the community pair and needs NC3 to be a Restena-connected
# establishment; confirm reachability from the NC3 network with the egress rule.
# Dev and CI: one public resolver, no corroboration.
#VERIFICATION_RESOLVERS=[{"address":"158.64.1.29","transport":"dot","port":853,"tls_hostname":"dnspub.restena.lu"}]
#VERIFICATION_RESOLVER_QUORUM=1
#
# This list is the platform's first structured setting and is ENVIRONMENT-ONLY:
# VERIFICATION_RESOLVERS_FILE does not work, because the file-indirection source
# never JSON-decodes a complex field. Every other variable still honours _FILE.
#VERIFICATION_QUERY_TIMEOUT_SECONDS=5.0
#VERIFICATION_DNS_TOTAL_DEADLINE_SECONDS=20.0
# Admission bulkhead. Must stay below the connection-pool ceiling (15): a check
# that outlives its connection starves every other operation on the same role.
#VERIFICATION_DNS_MAX_CONCURRENT_QUERIES=4
# Three windows, narrowest last. The global one is the only bound that does not
# divide by the number of organizations an attacker registers. It also sizes the
# process-local outbound-DNS window in `core/dns_utils.py` (this value times the
# number of configured resolvers, over the same window), which is what still
# bounds what the platform sends Restena and DNS4EU when Redis is unreachable and
# these windows fail open.
#VERIFICATION_GLOBAL_RATE_LIMIT=600
#VERIFICATION_GLOBAL_RATE_WINDOW_SECONDS=60
#VERIFICATION_ORG_RATE_LIMIT=60
#VERIFICATION_ORG_RATE_WINDOW_SECONDS=60
#VERIFICATION_CHECK_RATE_LIMIT=10
#VERIFICATION_CHECK_RATE_WINDOW_SECONDS=300

# Rauthy (development identity provider)
# Values not listed here live in infra/compose/rauthy/config.toml, which Rauthy requires as a file.
# The port appears in pub_url, rp_origin, and OIDC_DISCOVERY_URL; changing it changes all three.
RAUTHY_PORT=8080
RAUTHY_ADMIN_EMAIL=admin@localhost
RAUTHY_ADMIN_PASSWORD=DevAdmin.123456
RAUTHY_LOG_LEVEL=info

# Reverse proxy (development entry point, infra/compose/proxy.yml)
# The browser-facing way into the API; the API keeps its direct port below.
# 8888 because 8080 belongs to Rauthy and 8000 to the API.
PROXY_PORT=8888

# Application
# Host port the Compose stack maps the API container to. The host-run API
# (`make dev`) listens on the FastAPI default instead; pass --port to change it.
API_PORT=8000
# OIDC discovery for the host-run API only. Inside Compose the API defaults to
# the rauthy service hostname; setting this variable overrides both, so leave
# it unset unless you run the API on the host.
#OIDC_DISCOVERY_URL=http://localhost:8080/auth/v1/.well-known/openid-configuration
